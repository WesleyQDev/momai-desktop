{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [],
    "allowImportingTsExtensions": true,
    "strict": false,
    "noImplicitAny": false,
    "allowJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["runtime.ts", "worker.ts", "runtime-shim.d.ts", "uia/**/*.ts", "desktop/**/*.ts", "test/**/*.ts"]
}
