{
  "name": "momai-desktop",
  "version": "2.0.2",
  "private": true,
  "description": "MomAI Desktop: open programs and automate them through the Windows accessibility tree.",
  "type": "commonjs",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:ui": "tsc --noEmit -p tsconfig.ui.json",
    "package": "node ../package-extension.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "screenshot-desktop": "^1.15.6"
  }
}
